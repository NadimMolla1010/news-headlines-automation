    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a news editor. Below is a JSON list of headlines and links scraped from a Bangladeshi English newspaper's homepage today.\n\nSelect the 5 most newsworthy, important stories (prioritize national politics, economy, major international news, and significant local events; deprioritize sports scores, lifestyle, and opinion pieces unless nothing else qualifies).\n\nReturn ONLY valid JSON in this exact format, ordered from most to least important:\n[\n  {\"rank\": 1, \"title\": \"...\", \"link\": \"...\"},\n  {\"rank\": 2, \"title\": \"...\", \"link\": \"...\"},\n  {\"rank\": 3, \"title\": \"...\", \"link\": \"...\"},\n  {\"rank\": 4, \"title\": \"...\", \"link\": \"...\"},\n  {\"rank\": 5, \"title\": \"...\", \"link\": \"...\"}\n]\n\nHeadlines:\n{{ JSON.stringify($json.data) }}",
        "batching": {}
      },
      "id": "39f582cd-bc05-416b-927d-b6d55626d843",
      "name": "Message a model",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        432,
        -16
      ]
    },
