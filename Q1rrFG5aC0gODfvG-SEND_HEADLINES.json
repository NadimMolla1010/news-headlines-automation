          "maxTokens": 1500
        }
      },
      "id": "dbd94c62-1c2b-49e7-9480-7a4372c23c55",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        720,
        208
      ],
      "credentials": {
        "openRouterApi": {
          "id": "kZX8QKXhHhc44ZQJ",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.text || $input.first().json.output || \"\").trim();\n\nconst cleaned = raw\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/, '')\n  .replace(/```$/, '')\n  .trim();\n\nconst top5 = JSON.parse(cleaned);\n\nconst today = new Date().toLocaleDateString('en-GB', {\n  day: 'numeric', month: 'long', year: 'numeric'\n});\n\nlet storiesHtml = '';\ntop5.forEach(story => {\n  storiesHtml += `<h3>${story.rank}. ${story.title}</h3>\n                  <p><a href=\"${story.link}\">${story.link}</a></p>`;\n});\n\nconst html = `<!DOCTYPE html>\n<html>\n<head><meta charset=\"UTF-8\"><title>Top 5 News</title></head>\n<body>\n<h1>Top 5 News — ${today}</h1>\n${storiesHtml}\n</body>\n</html>`;\n\nconst htmlBase64 = Buffer.from(html, 'utf-8').toString('base64');\n\nreturn [{ json: { html, htmlBase64, today } }];"
      },
