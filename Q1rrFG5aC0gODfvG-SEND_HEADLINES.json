    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst titles = data.title || [];\nconst links = data.link || [];\n\nconst BASE_URL = \"https://www.thedailystar.net\";\nconst seen = new Set();\nconst cleaned = [];\n\nfor (let i = 0; i < titles.length; i++) {\n  let title = (titles[i] || \"\").toString().trim();\n  let link = (links[i] || \"\").toString().trim();\n\n  if (!title || !link) continue;\n  if (seen.has(title)) continue;\n  seen.add(title);\n\n  if (link.startsWith(\"/\")) {\n    link = BASE_URL + link;\n  }\n\n  cleaned.push({ title, link });\n}\n\nreturn cleaned.map(c => ({ json: c }));"
      },
      "id": "04bdbaf9-daa4-4009-b330-f86233336d51",
      "name": "clean duplicate",
